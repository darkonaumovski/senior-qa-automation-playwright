# Legacy Allure output. New runs are isolated under .runs/.
allure-report/

# Snapshots of a single local run. CI artifacts and the published report on
# gh-pages are the evidence of record; committing these only guarantees they go
# stale and disagree with the live results.
allure-latest-report/
allure-latest-results/

# The application under test is cloned by CI and by the Dockerfiles at a pinned
# commit. It is deliberately not a submodule: a gitlink without .gitmodules
# leaves an unresolvable empty directory on clone.
cypress-example-kitchensink/
kitchensink/

# Legacy generated results; static categories now live under reporting/.
allure-results/*.json
allure-results/*.xml
allure-results/*.webm
allure-results/*.png
allure-results/*.zip
allure-results/*.md
allure-results/attachments/
allure-results/history/

