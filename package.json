{
  "name": "todo-playwright-tests",
  "version": "1.0.0",
  "description": "Playwright E2E test suite for the TodoMVC application (cypress-example-kitchensink)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:repeat": "playwright test --repeat-each=3",
    "test:docker": "docker compose up --build --abort-on-container-exit --exit-code-from tests",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "allure-playwright": "^3.0.0",
    "allure-commandline": "^2.30.0",
    "typescript": "^5.5.4"
  }
}
